# Copy to .env and fill in. NEVER commit a real .env file.

# ---- LLM provider -----------------------------------------------------------
# anthropic | openai | openai_compatible
LLM_PROVIDER=anthropic

# Model id. Optional for anthropic (defaults to claude-opus-5).
# REQUIRED for openai / openai_compatible - the app will not guess a model id.
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only for LLM_PROVIDER=openai_compatible (e.g. a local vLLM / LiteLLM gateway)
OPENAI_BASE_URL=

# Reasoning effort for Anthropic models: low | medium | high | xhigh | max
LLM_EFFORT=high

# Max output tokens per analysis call (covers thinking + JSON payload)
LLM_MAX_TOKENS=16000

# Server-side refusal fallback (Anthropic only). Automatically disabled if the
# installed SDK / account does not support it.
LLM_ENABLE_FALLBACK=true

# ---- Rendering --------------------------------------------------------------
# LETTER | A4
PAGE_SIZE=LETTER

# Show compact [S8] slide markers next to sourced claims
SHOW_SOURCE_REFERENCES=true

# Write the structured analysis next to the PDF as <name>.json
KEEP_ANALYSIS_JSON=true

# ---- Ingestion --------------------------------------------------------------
# OCR fallback for image-only slides (needs pytesseract + Tesseract binary)
ENABLE_OCR=false

# Optional explicit path to the LibreOffice binary used to convert legacy .ppt
# LIBREOFFICE_PATH=

# ---- Web deployment ---------------------------------------------------------
# Shared password for the Streamlit UI. Leave empty for local use; set it on any
# public deployment or anyone with the URL can spend your API credits.
APP_PASSWORD=

# PORT is injected by the hosting platform (Railway) - do not set it yourself.

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
